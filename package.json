{
  "name": "@bytecats/ui-kit",
  "version": "0.1.0",
  "description": "Bytecats shared React component library — shadcn/ui primitives themed with Meta Astryx's verified design tokens. One kit, many bytecats products.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:css && bun run build:js",
    "build:js": "tsup",
    "build:css": "bunx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tsup": "^8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4cecoder/ui-kit.git"
  },
  "homepage": "https://github.com/4cecoder/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/4cecoder/ui-kit/issues"
  },
  "keywords": [
    "react",
    "component-library",
    "ui-kit",
    "shadcn",
    "tailwindcss",
    "design-system",
    "astryx"
  ]
}
